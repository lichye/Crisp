mode kind
depth 5
properties buechi.p_quiet
free_kind:
mode kind
depth 5
properties buechi.p_quiet
pdr:
mode pdr
properties buechi.p_quiet
free_pdr:
mode pdr
properties buechi.p_quiet
multi_pdr:
mode pdr
properties buechi.*
unsupported_contract:
mode pdr
properties buechi.p_quiet
