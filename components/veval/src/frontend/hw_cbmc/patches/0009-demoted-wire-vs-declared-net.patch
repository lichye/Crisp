diff --git a/third_party/hw-cbmc/src/verilog/verilog_synthesis_class.h b/third_party/hw-cbmc/src/verilog/verilog_synthesis_class.h
index c5a3dc4..1122ec2 100644
--- a/third_party/hw-cbmc/src/verilog/verilog_synthesis_class.h
+++ b/third_party/hw-cbmc/src/verilog/verilog_synthesis_class.h
@@ -134,6 +134,15 @@ protected:
    
   typedef std::map<irep_idt, assignmentt> assignmentst;
   assignmentst assignments;
+
+  // Signals that synthesis itself turned from a variable into a wire, because
+  // something drove them combinationally. A later procedural assignment to
+  // one of these is legal -- the signal was declared assignable, and both
+  // drivers are combinational -- so it must be told apart from a signal the
+  // designer declared as a net. Without the distinction the two are
+  // indistinguishable by the time the second driver is synthesised, and
+  // whichever driver happens to come second is rejected.
+  std::set<irep_idt> demoted_to_wire;
   
   // for assumes
   typedef std::list<exprt> invarst;
