+  // veval: the `default' item applies when no other item matches, wherever
+  // it is written; its empty pattern list used to become `false', so the
+  // default was never taken.
+  for(auto it = case_items.begin(); it != case_items.end(); ++it)
+  {
+    if(it->patterns().empty()) // the `default' item
+    {
+      sva_case_exprt reduced = *this;
+      reduced.case_items().erase(
