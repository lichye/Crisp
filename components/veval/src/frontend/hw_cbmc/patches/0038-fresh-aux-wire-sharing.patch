--- a/src/verilog/verilog_synthesis.cpp
+++ b/src/verilog/verilog_synthesis.cpp
@@ -4183,8 +4183,15 @@
   if(new_value.is_nil())
     new_value=symbol_expr(symbol, CURRENT);
 
-  // see if wire is used to define itself
-  if(!symbol.is_lvalue)
+  // A replace_by_wire RHS predates its fresh identifier. Only that creation
+  // path inserts into new_wires, and later procedural writes update source
+  // variables, not these auxiliary definitions. Its RHS cannot directly
+  // reference itself. Walking it mutably would detach a shared update prefix
+  // even when nothing changes, causing quadratic storage for bitwise writes.
+  // Keep the original self-reference handling for all other wires, including
+  // incompletely assigned combinational variables. Do not use is_auxiliary:
+  // this invariant belongs specifically to replace_by_wire in this module.
+  if(!symbol.is_lvalue && new_wires.count(symbol.name) == 0)
   {
     post_process_wire(symbol.name, new_value);
   }
