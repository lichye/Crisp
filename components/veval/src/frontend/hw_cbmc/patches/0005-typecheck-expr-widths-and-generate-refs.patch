+        const auto &import = to_verilog_identifier_expr(f_op).import();
+
+        if(import.empty())
+          throw errort().with_location(f_op.source_location())
+            << "unknown function `" << base_name << "'";
+
+        full_identifier = "Verilog::" + id2string(import);
+
+        if(ns.lookup(full_identifier, symbol))
+          throw errort().with_location(f_op.source_location())
+            << "unknown function `" << base_name << "'";
       }
