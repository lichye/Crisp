diff --git a/third_party/hw-cbmc/src/verilog/verilog_synthesis.cpp b/third_party/hw-cbmc/src/verilog/verilog_synthesis.cpp
index 698ce52..dd39478 100644
--- a/third_party/hw-cbmc/src/verilog/verilog_synthesis.cpp
+++ b/third_party/hw-cbmc/src/verilog/verilog_synthesis.cpp
@@ -719,10 +719,29 @@ void verilog_synthesist::assignment_rec(
         assignment.type = new_type;
       else if(assignment.type != new_type)
       {
+        // 1800-2017 6.5 makes each ELEMENT of an unpacked array its own
+        // variable, so driving a[0] continuously and a[1:N] from an
+        // always_ff is legal and common -- a shift register with its head
+        // tied to an input. This model keeps one assignment kind per
+        // symbol, so it cannot express that, and the refusal is then a
+        // limitation here rather than a defect in the design. Say so:
+        // otherwise the message sends a reader hunting for a bug that is
+        // not there.
+        std::string note;
+
+        if(symbol.type.id() == ID_array &&
+           symbol.type.get(ID_C_verilog_type) == ID_verilog_unpacked_array)
+        {
+          note = ". Note that the elements of an unpacked array are separate "
+                 "variables (1800-2017 6.5), so this is legal if the two "
+                 "drivers touch different elements; this model tracks one "
+                 "assignment kind per symbol and cannot tell them apart";
+        }
+
         throw errort().with_location(lhs.source_location())
           << "conflicting assignment types for `" << symbol.base_name
           << "' (new: " << as_string(new_type)
-          << ", old: " << as_string(assignment.type) << ")";
+          << ", old: " << as_string(assignment.type) << ")" << note;
       }
 
       membert member;
