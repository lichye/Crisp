+// Preserve sharing in a pure expression as lexical let bindings. These are
+// combinational expressions, not design wires or additional temporal state.
+static exprt compact_sva_function(const exprt &root)
+{
+  std::map<const void *, std::size_t> uses;
+  std::function<void(const exprt &)> count = [&](const exprt &e)
+  {
+    if(++uses[&e.get_sub()] != 1)
+      return;
+    for(const auto &op : e.operands())
+      count(op);
+  };
+  count(root);
+  if(uses.size() < 32)
+    return root;
+  std::map<const void *, exprt> mapped;
+  std::vector<std::pair<symbol_exprt, exprt>> bindings;
+  std::function<exprt(const exprt &)> convert = [&](const exprt &e)
+  {
+    auto key = &e.get_sub();
+    auto found = mapped.find(key);
+    if(found != mapped.end())
+      return found->second;
+    auto value = e;
+    for(auto &op : value.operands())
+      op = convert(op);
+    if(uses.at(key) > 1 && !e.operands().empty() &&
+       (e.type().id() == ID_bool || can_cast_type<bitvector_typet>(e.type())))
+    {
+      symbol_exprt variable{"__cf_fn_tmp_" + std::to_string(bindings.size()),
+                            e.type()};
+      variable.set("#veval_sva_function_local", true);
+      bindings.emplace_back(variable, value);
+      value = variable;
+    }
+    mapped.emplace(key, value);
+    return value;
+  };
+  auto result = convert(root);
+  for(auto it = bindings.rbegin(); it != bindings.rend(); ++it)
+    result = let_exprt{it->first, it->second, result};
+  if(!bindings.empty())
+    result.set("#veval_sva_compact_function", true);
+  return result;
+}
