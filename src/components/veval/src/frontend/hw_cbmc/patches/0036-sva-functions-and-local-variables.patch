+// value only when every bit is covered. Reads in the written values still
+// undergo the ordinary uninitialized-local check.
+static exprt remove_overwritten_sva_bits(const exprt &root)
+{
+  std::map<const void *, exprt> mapped;
+  std::function<exprt(const exprt &)> convert = [&](const exprt &expression)
+  {
+    const auto key = &expression.get_sub();
+    auto found = mapped.find(key);
+    if(found != mapped.end())
+      return found->second;
+    if(expression.id() == ID_with &&
