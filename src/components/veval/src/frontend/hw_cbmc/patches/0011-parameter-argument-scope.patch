diff --git a/third_party/hw-cbmc/src/verilog/verilog_instantiate_module.cpp b/third_party/hw-cbmc/src/verilog/verilog_instantiate_module.cpp
index dcbeaf5..19dc032 100644
--- a/third_party/hw-cbmc/src/verilog/verilog_instantiate_module.cpp
+++ b/third_party/hw-cbmc/src/verilog/verilog_instantiate_module.cpp
@@ -143,6 +143,27 @@ std::list<exprt> verilog_typecheckt::get_parameter_values(
   // declared.
   for(auto &value : parameter_values)
   {
+    // A value parameter's argument is an expression in the INSTANTIATING
+    // module's scope, and this is the last point at which that scope is the
+    // current one. `#(.F((MODE & 1) != 0))` carried across as written is
+    // evaluated inside the instantiated copy, where `MODE` was never
+    // declared, and the result is silently a value of the wrong type rather
+    // than a diagnostic.
+    if(value.is_not_nil() && value.id() != ID_type)
+    {
+      try
+      {
+        convert_expr(value);
+        value = elaborate_constant_expression_check(value);
+      }
+      catch(...)
+      {
+        // Not a constant here -- leave it for the instantiated module to
+        // report, as before.
+      }
+      continue;
+    }
+
     if(value.id() != ID_type || value.type().id() != ID_typedef_type)
       continue;
 
