+static irep_idt compound_assign_operator(const irep_idt &statement)
+{
+  if(statement == ID_verilog_blocking_assign_plus)
+    return ID_plus;
+  else if(statement == ID_verilog_blocking_assign_minus)
+    return ID_minus;
+  else if(statement == ID_verilog_blocking_assign_mult)
+    return ID_mult;
+  else if(statement == ID_verilog_blocking_assign_div)
+    return ID_div;
+  else if(statement == ID_verilog_blocking_assign_mod)
+    return ID_mod;
+  else if(statement == ID_verilog_blocking_assign_bitand)
+    return ID_bitand;
+  else if(statement == ID_verilog_blocking_assign_bitor)
+    return ID_bitor;
+  else if(statement == ID_verilog_blocking_assign_bitxor)
+    return ID_bitxor;
+  else if(statement == ID_verilog_blocking_assign_lshr)
+    return ID_lshr;
+  else if(statement == ID_verilog_blocking_assign_lshl)
+    return ID_shl;
+  else if(statement == ID_verilog_blocking_assign_ashr)
+    return ID_ashr;
+  else if(statement == ID_verilog_blocking_assign_ashl)
+    return ID_shl;
+  else
+    return irep_idt{};
