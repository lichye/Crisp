-  // Do the operands recursively
-  for(auto &op : expr.operands())
-    op = synth_expr_rec(op, symbol_state);
+  // Read before writing: the mutable operand accessor detaches an entire
+  // shared node, even at a leaf or when every recursive result is unchanged.
+  // Preserve those nodes and detach only the parents of actual rewrites.
+  for(std::size_t i = 0; i < static_cast<const exprt &>(expr).operands().size();
+      ++i)
+  {
+    auto rewritten = synth_expr_rec(
+        static_cast<const exprt &>(expr).operands()[i], symbol_state);
+    if(&rewritten.read() !=
+       &static_cast<const exprt &>(expr).operands()[i].read())
+      expr.operands()[i] = std::move(rewritten);
+  }
 
