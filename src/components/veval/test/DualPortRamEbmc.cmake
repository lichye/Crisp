execute_process(COMMAND "${EBMC}" --systemverilog --bound 2 --top dual_port_ram "${DESIGN}"
    RESULT_VARIABLE result ERROR_VARIABLE error OUTPUT_VARIABLE output)
if(NOT result EQUAL 10)
    message(FATAL_ERROR "Expected EBMC to refute both fixed winners. Exit ${result}\n${output}\n${error}")
endif()
foreach(label IN ITEMS wrote_a wrote_b held_0 held_1 read_old whole_word)
    if(NOT output MATCHES "\\[dual_port_ram\\.${label}\\][^\n]*: PROVED up to bound 2")
        message(FATAL_ERROR "EBMC did not establish ${label}\n${output}\n${error}")
    endif()
endforeach()
foreach(label IN ITEMS only_a only_b)
    if(NOT output MATCHES "\\[dual_port_ram\\.${label}\\][^\n]*: REFUTED")
        message(FATAL_ERROR "EBMC did not refute ${label}\n${output}\n${error}")
    endif()
endforeach()
